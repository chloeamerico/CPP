/******LES STRUCT vs LES CLASSES ***********/

//En C :
typedef struct {
    int x;
    int y;
} Point;

void point_init(Point *p, int x, int y) {
    p->x = x;
    p->y = y;
}

//En C++ :

class Point {
    private:
        int x;
        int y;
    
    public:
        Point(int x, int y);  // Constructeur
        void display(void);   // Fonction membre
};

private : accessible uniquement dans la classe (par défaut dans class)

public : accessible de partout
