bibliothèque fstream

fonctions :

    std::ifstream : pour la lecture des fichiers.
    std::ofstream : pour l’écriture dans les fichiers.
    std::fstream : pour la lecture et l’écriture combinées.

pour ouvrir un fichier : .open()

Vérifier si le fichier est correctement ouvert à l’aide de .is_open(). 
Fermer le fichier avec .close().


lecture du fichier :
get() --> lit un seul caractère depuis le fichier
getline() --> lit une ligne complète depuis le fichier
read() --> lit des données binaires de manière séquentielle depuis un fichier

Écriture dans les fichiers :
put() --> écrit un seul caractère dans le fichier
write() --> écrit des données binaires de manière séquentielle dans un fichier

Modes d'ouverture :
ios::in pour la lecture
ios::out pour l''écriture
ios::app pour ajouter du contenu à la fin du fichier
ios::binary pour les opérations binaires,
ios::trunc pour supprimer le contenu existant.

Gestion des erreurs
fail() retourne vrai si une opération de lecture ou d'écriture a échoué
eof() vérifie si la fin du fichier a été atteinte
bad() détecte les erreurs graves d'entrée/sortie.
clear() réinitialise les indicateurs d'erreur du flux


ex pour ecrire dans un fichier :

#include <iostream>
#include <fstream>
using namespace std;

int main() {
    ofstream fichier("exemple.txt"); // Crée et ouvre le fichier

    if (fichier.is_open()) {
        fichier << "Bonjour, ceci est un fichier texte.\n";
        fichier << "L'écriture dans les fichiers est simple en C++.\n";
        fichier.close(); // Ferme le fichier
        cout << "Écriture réussie dans exemple.txt" << endl;
    } else {
        cout << "Erreur : Impossible d'ouvrir le fichier." << endl;
    }

    return 0;
}

ex Lecture depuis un fichier (std::ifstream):

#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    ifstream fichier("exemple.txt"); // Ouvre le fichier en lecture
    string ligne;

    if (fichier.is_open()) {
        while (getline(fichier, ligne)) { // Lit une ligne à la fois
            cout << ligne << endl;
        }
        fichier.close(); // Ferme le fichier
    } else {
        cout << "Erreur : Impossible de lire le fichier." << endl;
    }

    return 0;
}


ex : Lecture et écriture combinées (std::fstream) : 


#include <iostream>
#include <fstream>
#include <string>
using namespace std;

int main() {
    fstream fichier("exemple.txt", ios::in | ios::out); // Ouvre en lecture et écriture

    if (fichier.is_open()) {
        string ligne;

        while (getline(fichier, ligne)) { // Lit chaque ligne
            cout << "Ligne lue : " << ligne << endl;
        }

        fichier.seekp(0, ios::end); // Place le curseur en fin de fichier
        fichier << "Ajout d'une nouvelle ligne.\n"; // Écrit une nouvelle ligne

        fichier.close(); // Ferme le fichier
    } else {
        cout << "Erreur : Impossible d'ouvrir le fichier." << endl;
    }

    return 0;
}


